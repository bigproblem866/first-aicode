<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.erp</groupId>
        <artifactId>erp-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>erp-system</artifactId>
    <packaging>jar</packaging>
    <name>erp-system</name>
    <description>系统管理：登录认证、用户、角色、菜单、部门、字典。
                 登录认证放在本模块而不是独立服务：登录必然要查用户与权限，
                 拆成两个服务只会带来每次登录一次跨网络调用，MVP 阶段没有收益。</description>

    <dependencies>
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
