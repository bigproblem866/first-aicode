# ---- Java / Maven ----
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# ---- 本地配置 ----
# 开发用配置（application.yml / application-local.yml）是提交的：
# 里面的 erp/Erp@123456 只是本地开发库账号，由 sql/00_bootstrap.sql 创建，不是机密。
# 真正的机密（生产数据库密码、JWT 密钥）一律走环境变量
# DB_PASSWORD / ERP_JWT_SECRET，不写进任何 yml。
.env.local
.env.production.local

# ---- IDE ----
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/extensions.json
# IDEA 默认的编译输出目录。用 Maven 构建时产物在 target/，
# 但若 IDEA 把某目录当普通源码目录（见 README 的工程导入说明），
# 它会把 class 编到 out/ 下 —— 那是构建产物，不该进版本库。
out/

# ---- 前端 ----
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 运行产物 ----
logs/
*.log
*.pid
*.hprof

# ---- 参考截图 ----
# 截图来自第三方产品界面，且带个人手机号水印（临时许可），不提交到公开仓库。
docs/ui-reference/

